itzikrecipe.com {
    redir https://www.itzikrecipe.com{uri}
}

www.itzikrecipe.com {
    encode gzip

    @api path /api/*
    handle @api {
        reverse_proxy backend:4000
    }

    @socket path /socket.io/*
    handle @socket {
        reverse_proxy backend:4000
    }

    @html path *.html
    header @html Cache-Control "no-cache"

    handle {
        reverse_proxy frontend:5173
    }
}